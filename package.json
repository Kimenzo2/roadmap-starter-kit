{
	"name": "roadmap-page",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check:roadmap": "bun scripts/check-roadmap.ts",
		"cf:dev": "bun run build && wrangler dev",
		"cf:deploy": "bun run build && wrangler deploy",
		"cf:types": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run check:roadmap && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "5.57.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.128.0"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.5.4"
	}
}
